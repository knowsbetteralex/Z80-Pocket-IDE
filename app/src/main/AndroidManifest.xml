<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/octet-stream" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_spectrum"
        android:roundIcon="@drawable/ic_spectrum"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity
            android:name=".ToolsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".NumberConverterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ExampleDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ExampleCatalogActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ReferenceActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Broad MIME providers: DocumentsUI commonly reports .asm as text/plain. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/x-asm" />
                <data android:mimeType="application/x-asm" />
                <data android:mimeType="text/x-assembly" />
                <data android:mimeType="application/x-assembly" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- File-extension association for managers that dispatch file:// URIs.
                 A pathPattern is not enough for opaque content:// document IDs. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.asm" />
                <data android:pathPattern=".*\\.ASM" />
                <data android:pathPattern=".*\\.z80" />
                <data android:pathPattern=".*\\.Z80" />
            </intent-filter>
        </activity>

        <provider
            android:name=".TapContentProvider"
            android:authorities="${applicationId}.tap"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
